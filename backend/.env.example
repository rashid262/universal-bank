# Copy to .env and fill in real values. Never commit .env.

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bankdb
SPRING_DATASOURCE_USERNAME=bank_user
SPRING_DATASOURCE_PASSWORD=change-me

# Public URL of this backend (used in verification email links)
APP_BASE_URL=http://127.0.0.1:8080
# Frontend URL (verify-success redirect)
FRONTEND_URL=http://127.0.0.1:5173
# Comma-separated browser origins allowed to call the API (optional; defaults to local Vite)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app

# Brevo SMTP (Brevo dashboard > SMTP & API). MAIL_FROM must be a verified sender.
BREVO_SMTP_LOGIN=your-login@smtp-brevo.com
BREVO_SMTP_KEY=change-me
MAIL_FROM=you@example.com
# Use 2525 if your host blocks port 587
# MAIL_PORT=587

# JWT signing secret, at least 32 bytes. Generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-value
# Initial admin password, at least 12 characters
ADMIN_INITIAL_PASSWORD=change-me-strong-password
# Admin recovery: set true with a new ADMIN_INITIAL_PASSWORD, restart once, then set back to false
ADMIN_PASSWORD_RESET=false
